{% comment %}
  Cover for the umbrella-inversion post: a C60 cage (truncated icosahedron, seen down a five-fold axis, orthographic) with a
  pyramidal OH3+ inside. Coordinates are generated from the exact truncated-icosahedron construction; on hover the molecule flips.
{% endcomment %}
<style>
  .inv-cover {
    position: absolute;
    inset: 1.25rem 1.5rem 3.4rem;
    color: var(--global-theme-color);
    --inv-cover-o: #c4553a;
    --inv-cover-h: #f3f4f6;
    --inv-cover-h-edge: #8a909a;
  }
  html[data-theme='dark'] .inv-cover {
    --inv-cover-o: #e57c62;
    --inv-cover-h: #e9edf3;
    --inv-cover-h-edge: #b5bcc8;
  }
  .inv-cover-svg {
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
  }
  .inv-cover-back .e line {
    stroke: currentColor;
    stroke-opacity: 0.2;
    stroke-width: 1;
  }
  .inv-cover-back .n circle {
    fill: currentColor;
    fill-opacity: 0.3;
  }
  .inv-cover-front .e line {
    stroke: currentColor;
    stroke-opacity: 0.62;
    stroke-width: 1.5;
    stroke-linecap: round;
  }
  .inv-cover-front .n circle {
    fill: currentColor;
    fill-opacity: 0.88;
  }
  .inv-cover-mol {
    transform-origin: 300px 198px;
    transition: transform 1.1s cubic-bezier(0.5, -0.25, 0.3, 1.25);
  }
  .blog-entry-link:hover .inv-cover-mol,
  .blog-entry-link:focus-visible .inv-cover-mol {
    transform: scale(1, -1);
  }
  .inv-cover-mol .plane {
    fill: currentColor;
    fill-opacity: 0.12;
    stroke: currentColor;
    stroke-opacity: 0.35;
    stroke-width: 1;
    stroke-dasharray: 3 3;
  }
  .inv-cover-mol .b {
    stroke: var(--inv-cover-o);
    stroke-width: 4;
    stroke-linecap: round;
  }
  .inv-cover-mol .o {
    fill: var(--inv-cover-o);
  }
  .inv-cover-mol .h {
    fill: var(--inv-cover-h);
    stroke: var(--inv-cover-h-edge);
    stroke-width: 1.2;
  }
  @media (prefers-reduced-motion: reduce) {
    .inv-cover-mol {
      transition: none;
    }
  }
</style>
