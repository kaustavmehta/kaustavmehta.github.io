{% comment %}
  Cover for TBI part 3: a comorbidity network of 26 nodes in four soft clusters (deterministic force layout, baked in).
  Node size follows degree; the two largest hubs and one bridge between clusters are drawn in the warm accent.
{% endcomment %}
<style>
  .tbim-cover {
    position: absolute;
    inset: 1.5rem 1.5rem 3.4rem;
    color: var(--global-theme-color);
    --tbim-cover-hot: #d9483b;
  }
  html[data-theme='dark'] .tbim-cover {
    --tbim-cover-hot: #ff6b5c;
  }
  .tbim-cover-svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  .tbim-cover-edges line {
    stroke: currentColor;
    stroke-opacity: 0.26;
    stroke-width: 1;
  }
  .tbim-cover-edges line.is-hot {
    stroke: var(--tbim-cover-hot);
    stroke-opacity: 0.6;
    stroke-width: 1.5;
    stroke-linecap: round;
  }
  .tbim-cover-nodes circle {
    fill: currentColor;
    fill-opacity: 0.72;
  }
  .tbim-cover-nodes circle.is-hot {
    fill: var(--tbim-cover-hot);
    fill-opacity: 0.95;
  }
</style>
