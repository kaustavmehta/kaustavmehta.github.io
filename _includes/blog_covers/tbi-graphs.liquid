  .tbig-cover-edges line.is-hot {
    stroke: var(--tbig-cover-hot);
    stroke-opacity: 0.6;
    stroke-width: 1.5;
    stroke-linecap: round;
  }
  .tbig-cover-nodes circle {
    fill: currentColor;
    fill-opacity: 0.72;
