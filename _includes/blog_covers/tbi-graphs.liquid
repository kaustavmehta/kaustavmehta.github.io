  html[data-theme='dark'] .tbig-cover {
    --tbig-cover-hot: #ff6b5c;
  }
  .tbig-cover-svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  .tbig-cover-edges line {
    stroke: currentColor;
    stroke-opacity: 0.4;
    stroke-width: 1;
