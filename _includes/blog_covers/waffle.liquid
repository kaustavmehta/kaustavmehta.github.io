{% comment %}
  Cover for the COVID-19 mental health post: 6000 dots, one per patient, with the
  first 300 (those who received provisions) lit in the accent colour.
  100 x 60 grid; the lit block is the first three rows.
{% endcomment %}
<canvas class="cover-art" data-cols="100" data-rows="60" data-lit="300" aria-hidden="true"></canvas>
<svg
  class="cover-waffle"
  viewBox="0 0 400 240"
  preserveAspectRatio="xMidYMin slice"
  role="img"
  aria-label="6000 dots, one per patient, with 300 highlighted"
>
  <defs>
    <pattern id="cover-dot" width="4" height="4" patternUnits="userSpaceOnUse">
      <circle cx="2" cy="2" r="1.15" class="cover-dot-muted"></circle>
    </pattern>
    <pattern id="cover-dot-lit" width="4" height="4" patternUnits="userSpaceOnUse">
      <circle cx="2" cy="2" r="1.3" class="cover-dot-lit"></circle>
    </pattern>
    <linearGradient id="cover-fade" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff" stop-opacity="1"></stop>
      <stop offset="1" stop-color="#fff" stop-opacity="0.25"></stop>
    </linearGradient>
    <mask id="cover-mask"><rect width="400" height="240" fill="url(#cover-fade)"></rect></mask>
  </defs>
  <g mask="url(#cover-mask)">
    <rect width="400" height="240" fill="url(#cover-dot)"></rect>
    <rect class="cover-lit-rows" width="400" height="12" fill="url(#cover-dot-lit)"></rect>
  </g>
</svg>
<div class="cover-caption">
  <span class="cover-figure">300</span>
  <span class="cover-label">of 6,000 patients received food provisions</span>
</div>
