<div class="atmo-cv-entries">
  {% for content in entry.contents %}
    <article class="atmo-cv-entry">

      {%- comment -%}
        Sticky entry header: meta strip + title + institution + domains.
        Stays pinned while the description scrolls beneath.
      {%- endcomment -%}
      <header class="atmo-cv-header">
        <div class="atmo-cv-meta-row">
          {% if content.start_date or content.end_date or content.year %}
            <span class="atmo-cv-dates">
              {% if content.year %}
                {{ content.year }}
              {% else %}
                {% if content.start_date %}{{ content.start_date }}{% endif %}
                {% if content.start_date and (content.end_date or content.start_date) %}
                  <span class="atmo-cv-date-arrow">→</span>
                {% endif %}
                {% if content.end_date %}{{ content.end_date }}{% else %}{% if content.start_date %}Present{% endif %}{% endif %}
              {% endif %}
            </span>
          {% endif %}

          {% if content.location %}
            <span class="atmo-cv-meta-divider">·</span>
            <span class="atmo-cv-meta-item">
              <i class="fa-solid fa-location-dot atmo-cv-meta-icon"></i>
              {{ content.location }}
            </span>
          {% endif %}

          {% if content.key_people %}
            <span class="atmo-cv-meta-divider">·</span>
            <span class="atmo-cv-meta-item atmo-cv-collaborators">
              <i class="fa-solid fa-users atmo-cv-meta-icon"></i>
              {{ content.key_people }}
            </span>
          {% endif %}
        </div>

        {% if content.title %}
          <h3 class="atmo-cv-title">{{ content.title }}</h3>
        {% endif %}

        {% if content.institution or content.department %}
          <div class="atmo-cv-institution">
            {% if content.institution %}<span>{{ content.institution }}</span>{% endif %}
            {% if content.institution and content.department %}<span class="atmo-cv-dept-sep">·</span>{% endif %}
            {% if content.department %}<span class="atmo-cv-dept">{{ content.department }}</span>{% endif %}
          </div>
        {% endif %}

        {% if content.domains %}
          <div class="atmo-cv-domains">
            <div class="atmo-cv-pill-list">
              {% for domain in content.domains %}
                {% if domain.name %}
                  <span class="atmo-cv-domain{% if domain.description %} has-tooltip{% endif %}"
                        {% if domain.description %}data-tooltip="{{ domain.description | escape }}"{% endif %}>
                    {% if domain.icon %}<i class="{{ domain.icon }}"></i>{% endif %}
                    {{ domain.name }}
                    {% if domain.description %}<span class="atmo-cv-tooltip">{{ domain.description }}</span>{% endif %}
                  </span>
                {% else %}
                  <span class="atmo-cv-domain">{{ domain }}</span>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        {% endif %}
      </header>

      <div class="atmo-cv-grid{% unless content.skills %} atmo-cv-grid-solo{% endunless %}">

        {%- comment -%} Main content column (description + bullets + links + media) {%- endcomment -%}
        <div class="atmo-cv-main">
          {% if content.maindescription %}
            <div class="atmo-cv-description">{{ content.maindescription }}</div>
          {% endif %}

          {% if content.description %}
            <ul class="atmo-cv-bullets">
              {% for item in content.description %}
                <li>
                  {% if item.contents %}
                    <span class="item-title">{{ item.title }}</span>
                    <ul class="atmo-cv-subbullets">
                      {% for subitem in item.contents %}
                        <li>{{ subitem }}</li>
                      {% endfor %}
                    </ul>
                  {% else %}
                    {{ item }}
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
          {% endif %}

          {% if content.items %}
            <ul class="atmo-cv-bullets">
              {% for item in content.items %}
                <li>
                  {% if item.contents %}
                    <span class="item-title">{{ item.title }}</span>
                    <ul class="atmo-cv-subbullets">
                      {% for subitem in item.contents %}
                        <li>{{ subitem }}</li>
                      {% endfor %}
                    </ul>
                  {% else %}
                    {{ item }}
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
          {% endif %}

          {% if content.linkitems %}
            <div class="atmo-cv-links">
              {% for item in content.linkitems %}
                {% if item.link %}
                  <a href="{{ item.link }}" target="_blank" rel="noopener" class="atmo-cv-link">
                    {% if item.linkname %}{{ item.linkname }}{% else %}doc{% endif %}
                  </a>
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}

          {% if content.image or content.video %}
            <div class="atmo-cv-media">
              {% if content.media_caption %}
                <div class="atmo-cv-media-caption">{{ content.media_caption }}</div>
              {% endif %}
              {% if content.image %}
                {% if content.image.first %}
                  {% for image in content.image %}
                    <img src="{{ image | relative_url }}" alt="{{ content.title | default: 'CV image' }}" class="atmo-cv-image">
                  {% endfor %}
                {% else %}
                  <img src="{{ content.image | relative_url }}" alt="{{ content.title | default: 'CV image' }}" class="atmo-cv-image">
                {% endif %}
              {% endif %}
              {% if content.video %}
                {% assign video_src = content.video %}
                {% if video_src contains 'youtube.com' or video_src contains 'youtu.be' %}
                  {% if video_src contains 'youtu.be' %}
                    {% assign video_id = video_src | split: '/' | last %}
                  {% else %}
                    {% assign video_id = video_src | split: 'v=' | last | split: '&' | first %}
                  {% endif %}
                  <div class="atmo-cv-video"><iframe src="https://www.youtube.com/embed/{{ video_id }}" frameborder="0" allowfullscreen></iframe></div>
                {% elsif video_src contains 'vimeo.com' %}
                  {% assign video_id = video_src | split: '/' | last %}
                  <div class="atmo-cv-video"><iframe src="https://player.vimeo.com/video/{{ video_id }}" frameborder="0" allowfullscreen></iframe></div>
                {% else %}
                  <video class="atmo-cv-video" controls>
                    <source src="{{ video_src | relative_url }}" type="video/mp4">
                  </video>
                {% endif %}
              {% endif %}
            </div>
          {% endif %}
        </div>

        {%- comment -%} Skills sidebar (no longer sticky) {%- endcomment -%}
        {% if content.skills %}
          <aside class="atmo-cv-skills">
            <div class="atmo-cv-pill-label">Skills</div>
            <div class="atmo-cv-skill-rail">
              {% for skill in content.skills %}
                {% if skill.name %}
                  <span class="atmo-cv-skill{% if skill.description %} has-tooltip{% endif %}"
                        {% if skill.description %}data-tooltip="{{ skill.description | escape }}"{% endif %}>
                    {% if skill.icon %}<i class="{{ skill.icon }}"></i>{% endif %}
                    <span>{{ skill.name }}</span>
                    {% if skill.description %}<span class="atmo-cv-tooltip">{{ skill.description }}</span>{% endif %}
                  </span>
                {% else %}
                  <span class="atmo-cv-skill"><span>{{ skill }}</span></span>
                {% endif %}
              {% endfor %}
            </div>
          </aside>
        {% endif %}
      </div>
    </article>
    {% unless forloop.last %}<hr class="atmo-cv-sep">{% endunless %}
  {% endfor %}
</div>
